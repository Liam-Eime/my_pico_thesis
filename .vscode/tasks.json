{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure CMake (Pico)",
      "type": "shell",
      "command": "cmake -S . -B build -G \"NMake Makefiles\"",
      "isBackground": false,
      "problemMatcher": "$gcc",
      "group": "none"
    },
    {
      "label": "Build (Pico)",
      "type": "shell",
      "command": "cmake --build build",
      "dependsOn": "Configure CMake (Pico)",
      "isBackground": false,
      "problemMatcher": "$gcc",
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}